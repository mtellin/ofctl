*.swo

# Secrets and machine-local config
.env
.env.*
!.env.example
.netrc
*.pem
*.key
*.p12
*.mobileprovision

# Claude / agent local state
#
# Keep reusable project instructions commit-friendly, but ignore local session
# state and generated artifacts. If you add a public .claude/README.md,
# .claude/CLAUDE.md, .claude/agents/, or .claude/commands/, Git will track it.
.claude/local/
.claude/cache/
.claude/logs/
.claude/transcripts/
.claude/conversations/
.claude/sessions/
.claude/settings.local.json
.claude/*.local.*
